# Copie este arquivo para `.env` (na raiz do projeto) e preencha com os
# valores reais da sua instância do OpenProject. O arquivo `.env` NUNCA deve
# ir pro git (já está no .gitignore) — este aqui é só um exemplo/placeholder.

# URL base da instância do OpenProject (sem barra no final). Não precisa mais
# configurar uma API key aqui — cada pessoa loga com a própria, na tela de
# login do SmartFlow (gerada em: seu usuário > My account > Access tokens >
# API key, dentro do próprio OpenProject).
OPENPROJECT_URL=https://openproject.example.com

# API key da Anthropic (Claude). Gere em: https://console.anthropic.com/settings/keys
# Sem essa variável o botão "Resolver com IA" fica desabilitado (503).
ANTHROPIC_API_KEY=sk-ant-...

# Opcional — modelo usado na chamada. Padrão: claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# Connection string do Postgres (agenda persistida lá — cada user_id só vê a
# própria). Provider gerenciado (Neon/Supabase/Railway Postgres) fornece isso
# pronto, não precisa instalar Postgres na sua máquina.
DATABASE_URL=postgresql://user:senha@host:5432/dbname

# Chave de criptografia do cookie de sessão (Fernet, 32 bytes urlsafe-base64).
# Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar essa chave derruba todas as sessões ativas (força re-login geral).
SESSION_SECRET_KEY=
